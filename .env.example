# Mastra resolves anthropic/* models from this variable.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# GAHOOLE_DB_URL=file:./data/gahoole.db
# GAHOOLE_USER=local-user

# MCP tool policy — comma-separated `server` or `server_tool` names.
# Deny wins; an empty allowlist allows everything.
# MCP_ALLOW=fs_read_file,fs_list_directory
# MCP_DENY=fs_write_file,fs_edit_file,fs_move_file
# MCP_CONFIG=mcp.json

# Backend: ai-mode (default, browser, no key) or api (Claude API, tool calling)
# GAHOOLE_BACKEND=ai-mode
# GAHOOLE_HEADED=1                     # watch the AI Mode browser
# GAHOOLE_HL=ja                        # AI Mode page locale
# GAHOOLE_BROWSER_PROFILE=data/browser-profile
# GAHOOLE_TOOLS=0                      # disable the text tool protocol
# GAHOOLE_NO_SPINNER=1                 # no spinner while waiting
