{
  "name": "gahoole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gahoole — a local agent with a Claude Code-shaped lifecycle: process, session, turn, tool call.",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "smoke:mcp": "tsx src/smoke-mcp.ts",
    "demo": "tsx src/demo.ts",
    "smoke:handoff": "tsx src/smoke-handoff.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "smoke:aimode": "tsx src/smoke-aimode.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.59.0",
    "@mastra/libsql": "^1.20.0",
    "@mastra/mcp": "^1.16.0",
    "@mastra/memory": "^1.26.2",
    "cloakbrowser": "^0.5.7",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "gahoole": "./bin/gahoole.js"
  },
  "files": [
    "dist",
    "bin",
    "mcp.json.example",
    "README.md"
  ]
}
