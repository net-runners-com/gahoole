{
  "name": "gahoole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gahoole \u2014 a local agent with a Claude Code-shaped lifecycle: process, session, turn, tool call.",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "smoke:mcp": "tsx src/smoke-mcp.ts",
    "demo": "tsx src/demo.ts",
    "smoke:handoff": "tsx src/smoke-handoff.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "smoke:aimode": "tsx src/smoke-aimode.ts",
    "smoke:tools": "tsx src/smoke-tools.ts",
    "smoke:protocol": "tsx src/smoke-protocol.ts",
    "smoke:dom": "tsx src/smoke-dom.ts",
    "smoke:spinner": "tsx src/smoke-spinner.ts",
    "smoke:files": "tsx src/smoke-files.ts",
    "smoke:trust": "tsx src/smoke-trust.ts",
    "smoke:profile": "tsx src/smoke-profile.ts",
    "smoke:subagent": "tsx src/smoke-subagent.ts",
    "smoke:auto": "tsx src/smoke-auto.ts",
    "bench": "tsx src/bench.ts",
    "duel": "tsx src/duel.ts",
    "smoke:ratelimit": "tsx src/smoke-ratelimit.ts",
    "smoke:all": "npm run smoke:offline && npm run smoke:dom",
    "smoke:offline": "npm run smoke && npm run smoke:protocol && npm run smoke:tools && npm run smoke:files && npm run smoke:trust && npm run smoke:profile && npm run smoke:auto && npm run smoke:handoff && npm run smoke:spinner && npm run smoke:ratelimit && npm run smoke:cli",
    "smoke:cli": "tsx src/smoke-cli.ts",
    "canary": "tsx src/canary.ts",
    "ratelimit": "tsx src/ratelimit.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.59.0",
    "@mastra/libsql": "^1.20.0",
    "@mastra/mcp": "^1.16.0",
    "@mastra/memory": "^1.26.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cloakbrowser": "^0.5.7",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "gahoole": "./bin/gahoole.js"
  },
  "files": [
    "dist",
    "bin",
    "mcp.json.example",
    "README.md"
  ]
}
